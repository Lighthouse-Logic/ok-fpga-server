# Rust build output (workspace root + client-examples)
**/target/

# Python cache & packaging metadata
**/__pycache__/
*.pyc
*.egg-info/
**/*.egg-info/

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Windows debug symbols
*.pdb

# OS files
Thumbs.db
.DS_Store

# Environment files (may contain secrets)
.env
.env.local

# Server logs
logs/

# FPGA bitfiles: never commit (custom / user / Opal Kelly sample designs stay local)
*.bit

# Opal Kelly FrontPanel 6.1.0 proprietary SDK headers, libraries, and sample bitfiles
# (keep local on disk or set OK_FRONTPANEL_SDK_DIR; never commit to git)
FrontPanel-6.1.0/*
!FrontPanel-6.1.0/README.md
!FrontPanel-6.1.0/60-opalkelly.rules
!FrontPanel-6.1.0/ExampleBitfiles/
FrontPanel-6.1.0/ExampleBitfiles/*
!FrontPanel-6.1.0/ExampleBitfiles/README.md
